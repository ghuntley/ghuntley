<div .system-health-widget>
    <div .health-status>
        <div .status-item>
            <span .label>Overall Status:
            <span .value .#{healthStatusClass health}>#{healthStatus health}

        <div .health-checks>
            $forall (check, status) <- healthChecks health
                <div .check-item>
                    <span .label>#{check}:
                    <span .value .#{if status then "status-ok" else "status-error"}>
                        #{if status then "OK" else "Error"}

    <div .last-updated>
        Last updated: #{formatTime lastUpdated}
</div .system-health-widget>

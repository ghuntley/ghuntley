<section .metrics-dashboard>
  <div .dashboard-header>
    <h2>System Metrics Dashboard
    <div .dashboard-controls>
      <div .time-range-selector>
        <select #timeRange>
          <option value="5m">Last 5 minutes
          <option value="1h">Last hour
          <option value="6h">Last 6 hours
          <option value="24h">Last 24 hours
          <option value="7d">Last 7 days
          <option value="30d">Last 30 days
      <button .refresh-btn #refreshMetrics>
        <i .fas .fa-sync>
        Refresh

  <div .metrics-grid>
    <!-- System Overview -->
    <div .metric-panel #systemOverview>
      <h3>System Overview
      <div .metric-charts>
        <div .chart #activeConnectionsChart>
          <h4>Active Connections
          <div .chart-container>
        <div .chart #requestRateChart>
          <h4>Request Rate
          <div .chart-container>
        <div .chart #errorRateChart>
          <h4>Error Rate
          <div .chart-container>
        <div .chart #cacheHitRatioChart>
          <h4>Cache Hit Ratio
          <div .chart-container>

    <!-- Endpoint Performance -->
    <div .metric-panel #endpointPerformance>
      <h3>Endpoint Performance
      <div .metric-charts>
        <div .chart #latencyHeatmapChart>
          <h4>Request Latency Heatmap
          <div .chart-container>
        <div .chart #endpointThroughputChart>
          <h4>Throughput by Endpoint
          <div .chart-container>
        <div .chart #endpointErrorsChart>
          <h4>Error Rate by Endpoint
          <div .chart-container>
        <div .chart #responseSizeChart>
          <h4>Response Size Distribution
          <div .chart-container>

    <!-- Database Performance -->
    <div .metric-panel #databasePerformance>
      <h3>Database Performance
      <div .metric-charts>
        <div .chart #queryLatencyChart>
          <h4>Query Latency
          <div .chart-container>
        <div .chart #dbConnectionsChart>
          <h4>Active Connections
          <div .chart-container>
        <div .chart #dbErrorRateChart>
          <h4>Error Rate
          <div .chart-container>
        <div .chart #queryTypesChart>
          <h4>Query Types Distribution
          <div .chart-container>

    <!-- Git Operations -->
    <div .metric-panel #gitOperations>
      <h3>Git Operations
      <div .metric-charts>
        <div .chart #gitOperationRateChart>
          <h4>Operation Rate
          <div .chart-container>
        <div .chart #gitErrorRateChart>
          <h4>Error Rate
          <div .chart-container>
        <div .chart #gitDurationChart>
          <h4>Duration Distribution
          <div .chart-container>
        <div .chart #repoActivityChart>
          <h4>Repository Activity
          <div .chart-container>

    <!-- Cache Performance -->
    <div .metric-panel #cachePerformance>
      <h3>Cache Performance
      <div .metric-charts>
        <div .chart #cacheHitRateChart>
          <h4>Hit Rate
          <div .chart-container>
        <div .chart #cacheSizeChart>
          <h4>Size Utilization
          <div .chart-container>
        <div .chart #cacheEvictionChart>
          <h4>Eviction Rate
          <div .chart-container>
        <div .chart #cacheEfficiencyChart>
          <h4>Cache Efficiency
          <div .chart-container>

  <div .alerts-panel>
    <h3>Active Alerts
    <div #activeAlerts>
      <!-- Alerts will be dynamically populated here -->

  <div .export-panel>
    <h3>Export Data
    <div .export-buttons>
      <button .export-btn #exportCSV>
        <i .fas .fa-file-csv>
        Export CSV
      <button .export-btn #exportJSON>
        <i .fas .fa-file-code>
        Export JSON
      <button .export-btn #exportGrafana>
        <i .fas .fa-chart-line>
        Open in Grafana
</section .metrics-dashboard>

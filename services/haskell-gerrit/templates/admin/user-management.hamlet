<div .user-management-widget>
    <div .actions>
        <button .btn .btn-primary onclick="createUser()">
            <i .fas .fa-plus>
            Add User
        <button .btn .btn-secondary onclick="refreshUsers()">
            <i .fas .fa-sync>
            Refresh

    <div .user-list>
        <table .table>
            <thead>
                <tr>
                    <th>Name
                    <th>Email
                    <th>Role
                    <th>Status
                    <th>Actions
            <tbody>
                $forall user <- users
                    <tr>
                        <td>#{userName user}
                        <td>#{userEmail user}
                        <td>
                            <span .badge .#{userRoleClass user}>
                                #{userRole user}
                        <td>
                            <span .badge .#{userStatusClass user}>
                                #{userStatus user}
                        <td .actions>
                            <button .btn .btn-sm .btn-outline-primary onclick="editUser('#{userId user}')">
                                <i .fas .fa-edit>
                            <button .btn .btn-sm .btn-outline-danger onclick="deleteUser('#{userId user}')">
                                <i .fas .fa-trash>

    <div .pagination>
        <nav>
            <ul .pagination>
                $if hasPrevPage
                    <li .page-item>
                        <a .page-link href="?page=#{prevPage}">Previous
                $forall page <- pages
                    <li .page-item .#{if isCurrentPage page then "active" else ""}>
                        <a .page-link href="?page=#{page}">#{page}
                $if hasNextPage
                    <li .page-item>
                        <a .page-link href="?page=#{nextPage}">Next

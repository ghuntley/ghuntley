<div .modal .fade #serviceConfigModal tabindex="-1" aria-hidden="true">
    <div .modal-dialog .modal-lg>
        <div .modal-content>
            <div .modal-header>
                <h5 .modal-title>Edit Service Configuration
                <button type="button" .btn-close data-bs-dismiss="modal" aria-label="Close">

            <div .modal-body>
                <form #serviceConfigForm>
                    <div .form-group>
                        <label for="serviceConfigEditor">Configuration (JSON):
                        <textarea #serviceConfigEditor .form-control rows="15">

                    <div .alert .alert-info>
                        <i .fas .fa-info-circle>
                        Changes will take effect immediately after saving.

            <div .modal-footer>
                <button type="button" .btn .btn-secondary data-bs-dismiss="modal">Cancel
                <button type="submit" .btn .btn-primary>
                    <i .fas .fa-save>
                    Save Changes

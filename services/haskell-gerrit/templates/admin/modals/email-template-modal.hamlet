<div .modal .fade #templateEditorModal tabindex="-1" aria-hidden="true">
    <div .modal-dialog .modal-lg>
        <div .modal-content>
            <div .modal-header>
                <h5 .modal-title>Edit Email Template
                <button type="button" .btn-close data-bs-dismiss="modal" aria-label="Close">

            <div .modal-body>
                <form #templateForm>
                    <div .form-group>
                        <label for="templateSubject">Subject:
                        <input type="text" #templateSubject .form-control required>

                    <div .form-group .mt-3>
                        <label for="templateBody">Body:
                        <textarea #templateBody .form-control rows="12" required>

                    <div .form-group .mt-3>
                        <label>Available Variables:
                        <div .variable-preview>
                            $forall var <- variables
                                <span .badge .bg-secondary>#{var}

                    <div .alert .alert-info .mt-3>
                        <i .fas .fa-info-circle>
                        Use variables in the format ${variable_name} in your template.

            <div .modal-footer>
                <button type="button" .btn .btn-secondary data-bs-dismiss="modal">Cancel
                <button type="submit" .btn .btn-primary>
                    <i .fas .fa-save>
                    Save Changes

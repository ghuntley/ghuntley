<div .enterprise-management-widget>
    <div .enterprise-grid>
        <div .enterprise-section>
            <h3>Enterprise Settings
            <div .settings-form>
                <div .form-group>
                    <label>Enterprise Name
                    <input type="text" .form-control value="#{enterpriseName}">
                <div .form-group>
                    <label>Contact Email
                    <input type="email" .form-control value="#{enterpriseEmail}">
                <button .btn .btn-primary onclick="saveEnterpriseSettings()">
                    Save Settings

        <div .enterprise-section>
            <h3>License Management
            <div .license-info>
                <div .info-item>
                    <span .label>License Type:
                    <span .value>#{licenseType}
                <div .info-item>
                    <span .label>Expires:
                    <span .value>#{formatTime licenseExpiry}
                <div .info-item>
                    <span .label>Users:
                    <span .value>#{currentUsers} / #{maxUsers}
            <div .actions>
                <button .btn .btn-primary onclick="updateLicense()">
                    Update License

        <div .enterprise-section>
            <h3>Quota Management
            <div .quota-grid>
                <div .quota-item>
                    <h4>Storage Quota
                    <div .usage-bar>
                        <div .bar-fill style="width: #{storageQuotaPercent}%">
                    <div .details>
                        <span>Used: #{formatBytes storageUsed}
                        <span>Total: #{formatBytes storageQuota}

                <div .quota-item>
                    <h4>Project Quota
                    <div .usage-bar>
                        <div .bar-fill style="width: #{projectQuotaPercent}%">
                    <div .details>
                        <span>Used: #{currentProjects}
                        <span>Total: #{maxProjects}

                <div .quota-item>
                    <h4>User Quota
                    <div .usage-bar>
                        <div .bar-fill style="width: #{userQuotaPercent}%">
                    <div .details>
                        <span>Used: #{currentUsers}
                        <span>Total: #{maxUsers}

            <button .btn .btn-primary onclick="editQuotas()">
                Edit Quotas

        <div .enterprise-section>
            <h3>Analytics
            <div .analytics-grid>
                <div .chart>
                    <h4>User Growth
                    <div #userGrowthChart>

                <div .chart>
                    <h4>Project Activity
                    <div #projectActivityChart>

                <div .chart>
                    <h4>Storage Usage
                    <div #storageUsageChart>

            <div .date-range>
                <select .form-control onchange="updateAnalytics()">
                    <option value="7d">Last 7 Days
                    <option value="30d">Last 30 Days
                    <option value="90d">Last 90 Days
                    <option value="1y">Last Year

        <div .enterprise-section>
            <h3>Reports
            <div .report-list>
                <div .report-item>
                    <span .name>Usage Report
                    <button .btn .btn-sm .btn-primary onclick="generateReport('usage')">
                        Generate

                <div .report-item>
                    <span .name>Audit Report
                    <button .btn .btn-sm .btn-primary onclick="generateReport('audit')">
                        Generate

                <div .report-item>
                    <span .name>Compliance Report
                    <button .btn .btn-sm .btn-primary onclick="generateReport('compliance')">
                        Generate

            <div .generated-reports>
                <h4>Generated Reports
                <table .table>
                    <thead>
                        <tr>
                            <th>Report
                            <th>Generated
                            <th>Actions
                    <tbody>
                        $forall report <- reports
                            <tr>
                                <td>#{reportName report}
                                <td>#{formatTime $ reportGenerated report}
                                <td>
                                    <button .btn .btn-sm .btn-primary onclick="downloadReport('#{reportId report}')">
                                        Download

<div .admin-dashboard>
    <div .admin-header>
        <h1>Administrative Dashboard
        <p>Manage and monitor your Gerrit instance

    <div .admin-grid>
        <div .admin-section>
            <h2>System Health
            ^{systemHealthWidget}

        <div .admin-section>
            <h2>System Metrics
            ^{systemMetricsWidget}

        <div .admin-section>
            <h2>User Management
            ^{userManagementWidget}

        <div .admin-section>
            <h2>Resource Management
            ^{resourceManagementWidget}

        <div .admin-section>
            <h2>Security Management
            ^{securityManagementWidget}

        <div .admin-section>
            <h2>Enterprise Management
            ^{enterpriseManagementWidget}

        <div .admin-section>
            <h2>Configuration
            ^{configurationManagementWidget}

        <div .admin-section>
            <h2>Maintenance Tools
            ^{maintenanceToolsWidget}

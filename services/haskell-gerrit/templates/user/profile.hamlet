<div class="container">
  <div class="row">
    <div class="col-md-3">
      <div class="card">
        <div class="card-body text-center">
          <img src="https://www.gravatar.com/avatar/#{gravatarHash $ userEmail user}?s=150"
               class="rounded-circle mb-3" alt="Profile picture">
          <h4>#{userName user}
          <p class="text-muted">#{userEmail user}
          $if userIsAdmin user
            <span class="badge badge-primary">Administrator</span>

    <div class="col-md-9">
      <ul class="nav nav-tabs" role="tablist">
        <li class="nav-item">
          <a class="nav-link active" data-toggle="tab" href="#overview">Overview</a>
        <li class="nav-item">
          <a class="nav-link" data-toggle="tab" href="#activity">Activity</a>
        <li class="nav-item">
          <a class="nav-link" data-toggle="tab" href="#settings">Settings</a>

      <div class="tab-content mt-3">
        <div class="tab-pane fade show active" id="overview">
          <div class="row">
            <div class="col-md-6">
              <div class="card">
                <div class="card-header">
                  <h5 class="card-title mb-0">Statistics
                <div class="card-body">
                  <div class="row text-center">
                    <div class="col">
                      <h3>#{length userChanges}</h3>
                      <p class="text-muted">Changes</p>
                    <div class="col">
                      <h3>#{length userReviews}</h3>
                      <p class="text-muted">Reviews</p>
                    <div class="col">
                      <h3>#{length userWatchedProjects}</h3>
                      <p class="text-muted">Watched Projects</p>

            <div class="col-md-6">
              <div class="card">
                <div class="card-header">
                  <h5 class="card-title mb-0">Recent Activity
                <div class="card-body">
                  <div class="timeline">
                    $forall activity <- recentActivity
                      <div class="timeline-item">
                        <small class="text-muted">#{formatTime activity}
                        <p>#{activityDescription activity}

        <div class="tab-pane fade" id="activity">
          <div class="card">
            <div class="card-header">
              <ul class="nav nav-pills card-header-pills">
                <li class="nav-item">
                  <a class="nav-link active" href="#changes" data-toggle="tab">Changes</a>
                <li class="nav-item">
                  <a class="nav-link" href="#reviews" data-toggle="tab">Reviews</a>

            <div class="card-body">
              <div class="tab-content">
                <div class="tab-pane fade show active" id="changes">
                  $if null userChanges
                    <p class="text-muted text-center my-5">No changes yet</p>
                  $else
                    <div class="list-group">
                      $forall Entity changeId change <- userChanges
                        <a href="@{ChangeR $ keyToText changeId}" class="list-group-item list-group-item-action">
                          <div class="d-flex w-100 justify-content-between">
                            <h6 class="mb-1">#{changeSubject change}
                            <small>#{formatTime change}
                          <p class="mb-1">#{projectName $ changeProjectId change}
                          <small class="text-muted">#{show $ changeStatus change}

                <div class="tab-pane fade" id="reviews">
                  $if null userReviews
                    <p class="text-muted text-center my-5">No reviews yet</p>
                  $else
                    <div class="list-group">
                      $forall Entity reviewId review <- userReviews
                        <a href="@{ChangeR $ keyToText $ reviewChangeId review}" class="list-group-item list-group-item-action">
                          <div class="d-flex w-100 justify-content-between">
                            <h6 class="mb-1">#{changeSubject $ reviewChangeId review}
                            <small>#{formatTime review}
                          <p class="mb-1">Vote: #{showVote $ reviewVote review}
                          $maybe msg <- reviewMessage review
                            <small class="text-muted">#{msg}

        <div class="tab-pane fade" id="settings">
          <div class="card">
            <div class="card-header">
              <h5 class="card-title mb-0">Profile Settings
            <div class="card-body">
              <form method="post" action="@{ProfileR}/update">
                <div class="form-group">
                  <label for="name">Display Name
                  <input type="text" class="form-control" id="name" name="name"
                         value="#{userName user}" required>

                <div class="form-group">
                  <label for="email">Email Address
                  <input type="email" class="form-control" id="email" name="email"
                         value="#{userEmail user}" required>

                <div class="form-group">
                  <label for="password">New Password
                  <input type="password" class="form-control" id="password" name="password"
                         placeholder="Leave blank to keep current password">

                <button type="submit" class="btn btn-primary">Save Changes

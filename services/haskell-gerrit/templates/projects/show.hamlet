<div class="container">
  <div class="row mb-4">
    <div class="col">
      <h2>#{projectName project}
      $maybe desc <- projectDescription project
        <p class="text-muted">#{desc}

  <div class="row">
    <!-- Project Statistics -->
    <div class="col-md-12 mb-4">
      <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h5 class="card-title mb-0">Project Statistics
          <div class="btn-group">
            <button class="btn btn-outline-secondary" id="exportCSV">
              <i class="fas fa-file-csv"></i> CSV
            <button class="btn btn-outline-secondary" id="exportJSON">
              <i class="fas fa-file-code"></i> JSON
            <button class="btn btn-outline-secondary" id="exportPDF">
              <i class="fas fa-file-pdf"></i> PDF
            <button class="btn btn-outline-secondary" id="exportExcel">
              <i class="fas fa-file-excel"></i> Excel
            <button class="btn btn-outline-secondary" id="exportSVG">
              <i class="fas fa-file-image"></i> SVG
        <div class="card-body">
          <div class="row">
            <div class="col-md-3 text-center">
              <div class="stats-group mb-4">
                <h6 class="text-muted">Changes</h6>
                <div class="row">
                  <div class="col">
                    <h3 id="totalChanges">#{totalChanges}</h3>
                    <p class="text-muted">Total</p>
                  </div>
                  <div class="col">
                    <h3 id="openChanges">#{openChanges}</h3>
                    <p class="text-muted">Open</p>
                  </div>
                </div>
                <div class="row">
                  <div class="col">
                    <h3 id="mergedChanges">#{mergedChanges}</h3>
                    <p class="text-muted">Merged</p>
                  </div>
                  <div class="col">
                    <h3 id="abandonedChanges">#{abandonedChanges}</h3>
                    <p class="text-muted">Abandoned</p>
                  </div>
                </div>
              </div>
            </div>
            <div class="col-md-3 text-center">
              <div class="stats-group mb-4">
                <h6 class="text-muted">Reviews</h6>
                <div class="row">
                  <div class="col">
                    <h3 id="totalReviews">#{totalReviews}</h3>
                    <p class="text-muted">Total Reviews</p>
                  </div>
                  <div class="col">
                    <h3 id="averageReviewTime">#{formatDuration averageReviewTime}</h3>
                    <p class="text-muted">Avg Review Time</p>
                  </div>
                </div>
                <div class="row">
                  <div class="col">
                    <h3 id="reviewThroughput">#{reviewThroughput}</h3>
                    <p class="text-muted">Reviews/Day</p>
                  </div>
                  <div class="col">
                    <h3 id="averageComments">#{averageComments}</h3>
                    <p class="text-muted">Avg Comments</p>
                  </div>
                </div>
              </div>
            </div>
            <div class="col-md-3 text-center">
              <div class="stats-group mb-4">
                <h6 class="text-muted">Code Metrics</h6>
                <div class="row">
                  <div class="col">
                    <h3 id="totalContributors">#{totalContributors}</h3>
                    <p class="text-muted">Contributors</p>
                  </div>
                  <div class="col">
                    <h3 id="codeChurnRate">#{codeChurnRate}</h3>
                    <p class="text-muted">Lines/Day</p>
                  </div>
                </div>
                <div class="row">
                  <div class="col">
                    <h3 id="mergeRatio">#{mergeRatio}%</h3>
                    <p class="text-muted">Merge Rate</p>
                  </div>
                  <div class="col">
                    <h3 id="totalFiles">#{totalFiles}</h3>
                    <p class="text-muted">Files</p>
                  </div>
                </div>
              </div>
            </div>
            <div class="col-md-3 text-center">
              <div class="stats-group mb-4">
                <h6 class="text-muted">Quality Metrics</h6>
                <div class="row">
                  <div class="col">
                    <h3 id="codeCoverage">#{codeCoverage}%</h3>
                    <p class="text-muted">Coverage</p>
                  </div>
                  <div class="col">
                    <h3 id="testCount">#{testCount}</h3>
                    <p class="text-muted">Tests</p>
                  </div>
                </div>
                <div class="row">
                  <div class="col">
                    <h3 id="issueCount">#{issueCount}</h3>
                    <p class="text-muted">Issues</p>
                  </div>
                  <div class="col">
                    <h3 id="techDebt">#{techDebt}</h3>
                    <p class="text-muted">Tech Debt</p>
                  </div>
                </div>
              </div>
            </div>
          </div>

  <div class="row">
    <!-- Activity Graph -->
    <div class="col-md-8 mb-4">
      <div class="card">
        <div class="card-header">
          <div class="d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0">Activity Over Time
            <div>
              <div class="btn-group btn-group-sm mr-2">
                <select class="form-control form-control-sm" id="timeRange">
                  <option value="week">Week</option>
                  <option value="month">Month</option>
                  <option value="quarter">Quarter</option>
                  <option value="year">Year</option>
                </div>
                <div class="btn-group btn-group-sm">
                  <div class="form-check form-check-inline">
                    <input class="form-check-input metric-toggle" type="checkbox" value="Changes" checked>
                    <label class="form-check-label">Changes</label>
                  </div>
                  <div class="form-check form-check-inline">
                    <input class="form-check-input metric-toggle" type="checkbox" value="Reviews" checked>
                    <label class="form-check-label">Reviews</label>
                  </div>
                  <div class="form-check form-check-inline">
                    <input class="form-check-input metric-toggle" type="checkbox" value="Code Churn">
                    <label class="form-check-label">Code Churn</label>
                  </div>
                  <div class="form-check form-check-inline">
                    <input class="form-check-input metric-toggle" type="checkbox" value="Review Time">
                    <label class="form-check-label">Review Time</label>
                  </div>
                  <div class="form-check form-check-inline">
                    <input class="form-check-input metric-toggle" type="checkbox" value="Complexity Score">
                    <label class="form-check-label">Complexity</label>
                  </div>
                  <div class="form-check form-check-inline">
                    <input class="form-check-input metric-toggle" type="checkbox" value="Test Coverage">
                    <label class="form-check-label">Coverage</label>
                  </div>
                </div>
                <div class="form-check form-check-inline ml-2">
                  <input class="form-check-input" type="checkbox" id="showTrendline">
                  <label class="form-check-label">Show Trend</label>
                </div>
                <div class="form-check form-check-inline">
                  <input class="form-check-input" type="checkbox" id="enableComparison">
                  <label class="form-check-label">Compare</label>
                </div>
        <div class="card-body">
          <canvas id="activityGraph"></canvas>

    <!-- Code Quality -->
    <div class="col-md-4 mb-4">
      <div class="card">
        <div class="card-header">
          <h5 class="card-title mb-0">Code Quality Metrics
        <div class="card-body">
          <canvas id="qualityGraph"></canvas>

  <div class="row">
    <!-- Contributors Graph -->
    <div class="col-md-12 mb-4">
      <div class="card">
        <div class="card-header">
          <div class="d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0">Contributor Analytics
            <div>
              <select class="form-control form-control-sm w-auto" id="contributorsPeriod">
                <option value="week">This Week</option>
                <option value="month">This Month</option>
                <option value="year">This Year</option>
                <option value="all">All Time</option>
        <div class="card-body">
          <div class="row">
            <div class="col-md-4">
              <canvas id="contributorsGraph"></canvas>
            </div>
            <div class="col-md-8">
              <div class="table-responsive">
                <table class="table table-sm" id="contributorStats">
                  <thead>
                    <tr>
                      <th>Contributor</th>
                      <th>Commits</th>
                      <th>Reviews</th>
                      <th>Lines Changed</th>
                      <th>Avg Review Time</th>
                      <th>Merge Rate</th>
                      <th>Avg Comments</th>
                  <tbody>
                    <!-- Populated by JavaScript -->

  <!-- Recent Activity -->
  <div class="row">
    <div class="col-md-12 mb-4">
      <div class="card">
        <div class="card-header">
          <h5 class="card-title mb-0">Recent Activity
        <div class="card-body p-0">
          <div class="list-group list-group-flush">
            $forall activity <- recentActivity
              <div class="list-group-item">
                <div class="d-flex w-100 justify-content-between">
                  <p class="mb-1">#{activityDescription activity}</p>
                  <small class="text-muted">#{formatTime activity}</small>

  <!-- Development Velocity -->
  <div class="row">
    <div class="col-md-12 mb-4">
      <div class="card">
        <div class="card-header">
          <h5 class="card-title mb-0">Development Velocity
        <div class="card-body">
          <canvas id="velocityGraph"></canvas>
          <div class="mt-3">
            <div class="row">
              <div class="col-md-3">
                <div class="card bg-light">
                  <div class="card-body">
                    <h6 class="card-title">Velocity Score</h6>
                    <h3 id="velocityScore">#{velocityScore}</h3>
                    <p class="text-muted mb-0">Changes per day weighted by complexity</p>
                  </div>
                </div>
              </div>
              <div class="col-md-3">
                <div class="card bg-light">
                  <div class="card-body">
                    <h6 class="card-title">Complexity Trend</h6>
                    <h3 id="complexityTrend">#{complexityTrend}</h3>
                    <p class="text-muted mb-0">Average complexity per change</p>
                  </div>
                </div>
              </div>
              <div class="col-md-3">
                <div class="card bg-light">
                  <div class="card-body">
                    <h6 class="card-title">Test Coverage</h6>
                    <h3 id="testCoverage">#{testCoverage}%</h3>
                    <p class="text-muted mb-0">Code covered by tests</p>
                  </div>
                </div>
              </div>
              <div class="col-md-3">
                <div class="card bg-light">
                  <div class="card-body">
                    <h6 class="card-title">Technical Debt</h6>
                    <h3 id="technicalDebt">#{technicalDebt}</h3>
                    <p class="text-muted mb-0">Estimated hours to resolve</p>
                  </div>
                </div>
              </div>
            </div>
          </div>

  <!-- Add Chart.js and project-stats.js -->
  <script src="@{StaticR js_project_stats_js}"></script>
  <script>
    // Initialize data for charts
    const activityData = #{toJSON projectActivity};
    const contributorsData = #{toJSON contributorsStats};
    const qualityData = #{toJSON qualityMetrics};
</div>

<div class="container">
  <div class="row mb-4">
    <div class="col">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="@{ProjectsR}">Projects</a>
          <li class="breadcrumb-item"><a href="@{ProjectR projectName}">#{projectName}</a>
          <li class="breadcrumb-item active">Settings

  <div class="row">
    <div class="col-md-3">
      <div class="list-group">
        <a class="list-group-item list-group-item-action active" href="#general" data-toggle="tab">
          <i class="fas fa-cog mr-2"></i>General
        <a class="list-group-item list-group-item-action" href="#branches" data-toggle="tab">
          <i class="fas fa-code-branch mr-2"></i>Branches
        <a class="list-group-item list-group-item-action" href="#access" data-toggle="tab">
          <i class="fas fa-lock mr-2"></i>Access Control
        <a class="list-group-item list-group-item-action" href="#webhooks" data-toggle="tab">
          <i class="fas fa-plug mr-2"></i>Webhooks
        <a class="list-group-item list-group-item-action" href="#submit-rules" data-toggle="tab">
          <i class="fas fa-check-square mr-2"></i>Submit Rules

    <div class="col-md-9">
      <div class="tab-content">
        <div class="tab-pane fade show active" id="general">
          <div class="card">
            <div class="card-header">
              <h5 class="card-title mb-0">General Settings
            <div class="card-body">
              <form method="post" action="@{ProjectR projectName}/settings">
                <div class="form-group">
                  <label>Project Name</label>
                  <input type="text" class="form-control" name="name" value="#{projectName}" required>
                <div class="form-group">
                  <label>Description</label>
                  <textarea class="form-control" name="description" rows="3">#{projectDescription}</textarea>
                <div class="form-group">
                  <label>Default Branch</label>
                  <select class="form-control" name="defaultBranch">
                    $forall branch <- projectBranches
                      <option :branch == defaultBranch:selected>#{branch}</option>
                <div class="form-group">
                  <div class="custom-control custom-switch">
                    <input type="checkbox" class="custom-control-input" id="requireSignedOff" name="requireSignedOff" :projectRequireSignedOff:checked>
                    <label class="custom-control-label" for="requireSignedOff">Require Signed-off-by in commit message</label>
                <button type="submit" class="btn btn-primary">Save Changes</button>

        <div class="tab-pane fade" id="branches">
          <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
              <h5 class="card-title mb-0">Branch Management
              <button class="btn btn-primary btn-sm" data-toggle="modal" data-target="#createBranchModal">
                <i class="fas fa-plus"></i> Create Branch
            <div class="card-body">
              <div class="table-responsive">
                <table class="table table-hover">
                  <thead>
                    <tr>
                      <th>Name</th>
                      <th>Revision</th>
                      <th>Updated</th>
                      <th>Protection</th>
                      <th>Actions</th>
                  <tbody>
                    $forall branch <- projectBranches
                      <tr>
                        <td>#{branchName branch}</td>
                        <td><code>#{branchRevision branch}</code></td>
                        <td>#{formatTime $ branchUpdated branch}</td>
                        <td>
                          $if branchProtected branch
                            <span class="badge badge-success">Protected</span>
                          $else
                            <span class="badge badge-secondary">Not Protected</span>
                        <td>
                          <div class="btn-group btn-group-sm">
                            <button class="btn btn-outline-primary" onclick="editBranch('#{branchName branch}')">
                              <i class="fas fa-edit"></i>
                            <button class="btn btn-outline-danger" onclick="deleteBranch('#{branchName branch}')">
                              <i class="fas fa-trash"></i>

        <div class="tab-pane fade" id="access">
          <div class="card">
            <div class="card-header">
              <h5 class="card-title mb-0">Access Control
            <div class="card-body">
              <form method="post" action="@{ProjectR projectName}/access">
                <h6 class="mb-3">Global Access</h6>
                <div class="form-group">
                  <label>Project Visibility</label>
                  <select class="form-control" name="visibility">
                    <option value="public" :projectVisibility == "public":selected>Public</option>
                    <option value="private" :projectVisibility == "private":selected>Private</option>
                    <option value="internal" :projectVisibility == "internal":selected>Internal</option>

                <h6 class="mb-3 mt-4">Reference Access</h6>
                <div class="reference-access">
                  $forall ref <- projectRefs
                    <div class="card mb-3">
                      <div class="card-header">
                        <code>#{refPattern ref}</code>
                      <div class="card-body">
                        <div class="table-responsive">
                          <table class="table table-sm">
                            <thead>
                              <tr>
                                <th>Group</th>
                                <th>Read</th>
                                <th>Write</th>
                                <th>Submit</th>
                                <th>Force Push</th>
                                <th>Actions</th>
                            <tbody>
                              $forall access <- refAccess ref
                                <tr>
                                  <td>#{groupName $ accessGroup access}</td>
                                  <td><input type="checkbox" :accessRead access:checked></td>
                                  <td><input type="checkbox" :accessWrite access:checked></td>
                                  <td><input type="checkbox" :accessSubmit access:checked></td>
                                  <td><input type="checkbox" :accessForcePush access:checked></td>
                                  <td>
                                    <button class="btn btn-sm btn-outline-danger" onclick="removeAccess('#{refPattern ref}', '#{groupName $ accessGroup access}')">
                                      <i class="fas fa-times"></i>

                  <button class="btn btn-outline-primary btn-sm mt-3" onclick="addReference()">
                    <i class="fas fa-plus"></i> Add Reference

                <button type="submit" class="btn btn-primary mt-4">Save Access Rights</button>

        <div class="tab-pane fade" id="webhooks">
          <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
              <h5 class="card-title mb-0">Webhooks
              <button class="btn btn-primary btn-sm" data-toggle="modal" data-target="#createWebhookModal">
                <i class="fas fa-plus"></i> Add Webhook
            <div class="card-body">
              <div class="table-responsive">
                <table class="table table-hover">
                  <thead>
                    <tr>
                      <th>URL</th>
                      <th>Events</th>
                      <th>Status</th>
                      <th>Actions</th>
                  <tbody>
                    $forall webhook <- projectWebhooks
                      <tr>
                        <td>#{webhookUrl webhook}</td>
                        <td>
                          $forall event <- webhookEvents webhook
                            <span class="badge badge-info mr-1">#{event}</span>
                        <td>
                          $if webhookActive webhook
                            <span class="badge badge-success">Active</span>
                          $else
                            <span class="badge badge-danger">Inactive</span>
                        <td>
                          <div class="btn-group btn-group-sm">
                            <button class="btn btn-outline-primary" onclick="editWebhook('#{webhookId webhook}')">
                              <i class="fas fa-edit"></i>
                            <button class="btn btn-outline-danger" onclick="deleteWebhook('#{webhookId webhook}')">
                              <i class="fas fa-trash"></i>

        <div class="tab-pane fade" id="submit-rules">
          <div class="card">
            <div class="card-header">
              <h5 class="card-title mb-0">Submit Rules
            <div class="card-body">
              <form method="post" action="@{ProjectR projectName}/submit-rules">
                <div class="form-group">
                  <label>Required Approvals</label>
                  <div class="required-approvals">
                    $forall approval <- requiredApprovals
                      <div class="approval-rule mb-3">
                        <div class="input-group">
                          <select class="form-control" name="label">
                            <option value="Code-Review" :approvalLabel approval == "Code-Review":selected>Code Review</option>
                            <option value="Verified" :approvalLabel approval == "Verified":selected>Verified</option>
                          <select class="form-control" name="value">
                            <option value="+2" :approvalValue approval == "+2":selected>+2</option>
                            <option value="+1" :approvalValue approval == "+1":selected>+1</option>
                          <div class="input-group-append">
                            <button class="btn btn-outline-danger" type="button" onclick="removeApproval(this)">
                              <i class="fas fa-times"></i>

                  <button type="button" class="btn btn-outline-primary btn-sm" onclick="addApproval()">
                    <i class="fas fa-plus"></i> Add Approval Rule

                <div class="form-group mt-4">
                  <div class="custom-control custom-switch">
                    <input type="checkbox" class="custom-control-input" id="submitMergeConflict" name="submitMergeConflict" :allowSubmitWithConflicts:checked>
                    <label class="custom-control-label" for="submitMergeConflict">Allow submit with merge conflicts</label>

                <div class="form-group">
                  <div class="custom-control custom-switch">
                    <input type="checkbox" class="custom-control-input" id="requireLinearHistory" name="requireLinearHistory" :requireLinearHistory:checked>
                    <label class="custom-control-label" for="requireLinearHistory">Require linear history</label>

                <div class="form-group">
                  <label>Merge Strategy</label>
                  <select class="form-control" name="mergeStrategy">
                    <option value="merge" :mergeStrategy == "merge":selected>Create merge commit</option>
                    <option value="rebase" :mergeStrategy == "rebase":selected>Rebase and merge</option>
                    <option value="squash" :mergeStrategy == "squash":selected>Squash and merge</option>

                <button type="submit" class="btn btn-primary">Save Submit Rules</button>

<!-- Create Branch Modal -->
<div class="modal fade" id="createBranchModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Create Branch
        <button type="button" class="close" data-dismiss="modal">
          <span>&times;
      <div class="modal-body">
        <form method="post" action="@{ProjectR projectName}/branches">
          <div class="form-group">
            <label>Branch Name</label>
            <input type="text" class="form-control" name="name" required>
          <div class="form-group">
            <label>Starting Point</label>
            <select class="form-control" name="startPoint">
              $forall ref <- projectRefs
                <option>#{refPattern ref}</option>
          <div class="form-group">
            <div class="custom-control custom-checkbox">
              <input type="checkbox" class="custom-control-input" id="protected" name="protected">
              <label class="custom-control-label" for="protected">Protected Branch</label>
          <button type="submit" class="btn btn-primary">Create Branch</button>

<!-- Create Webhook Modal -->
<div class="modal fade" id="createWebhookModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Add Webhook
        <button type="button" class="close" data-dismiss="modal">
          <span>&times;
      <div class="modal-body">
        <form method="post" action="@{ProjectR projectName}/webhooks">
          <div class="form-group">
            <label>URL</label>
            <input type="url" class="form-control" name="url" required>
          <div class="form-group">
            <label>Events</label>
            <div class="custom-control custom-checkbox">
              <input type="checkbox" class="custom-control-input" id="eventPush" name="events[]" value="push">
              <label class="custom-control-label" for="eventPush">Push</label>
            <div class="custom-control custom-checkbox">
              <input type="checkbox" class="custom-control-input" id="eventMerge" name="events[]" value="merge">
              <label class="custom-control-label" for="eventMerge">Merge</label>
            <div class="custom-control custom-checkbox">
              <input type="checkbox" class="custom-control-input" id="eventComment" name="events[]" value="comment">
              <label class="custom-control-label" for="eventComment">Comment</label>
          <div class="form-group">
            <div class="custom-control custom-switch">
              <input type="checkbox" class="custom-control-input" id="active" name="active" checked>
              <label class="custom-control-label" for="active">Active</label>
          <button type="submit" class="btn btn-primary">Add Webhook</button>
</div>

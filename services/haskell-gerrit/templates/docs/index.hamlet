<script>
$(document).ready(function() {
    // Activate sidebar nav
    var hash = window.location.hash;
    if (hash) {
        $(`.bd-toc-item:has(a[href="${hash}"])`).addClass('active');
    }

    // Handle navigation
    $('.bd-toc-link').click(function(e) {
        e.preventDefault();
        $('.bd-toc-item').removeClass('active');
        $(this).closest('.bd-toc-item').addClass('active');
    });

    // Syntax highlighting
    hljs.highlightAll();

    // Smooth scrolling
    $('a[href^="#"]').click(function(e) {
        e.preventDefault();
        var target = $(this).attr('href');
        $('html, body').animate({
            scrollTop: $(target).offset().top - 20
        }, 500);
    });
});
</script>

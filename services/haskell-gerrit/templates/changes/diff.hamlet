<div class="card">
  <div class="card-header">
    <h4 class="mb-0">
      <a href="@{ChangeR $ keyToText changeId}">#{changeSubject change}
      <small class="text-muted">Diff

  <div class="card-body p-0">
    <div class="list-group list-group-flush">
      $forall diff <- diffs
        <div class="list-group-item" id="#{gdOldPath diff}">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <h5 class="mb-0">
              $if gdOldPath diff == gdNewPath diff
                #{gdOldPath diff}
              $else
                #{gdOldPath diff} → #{gdNewPath diff}
            <div>
              <span class="badge badge-light">#{gdOldMode diff} → #{gdNewMode diff}
              <button class="btn btn-sm btn-outline-secondary ml-2" data-toggle="modal" data-target="#commentModal" data-file="#{gdNewPath diff}">Comment

          <div class="diff-content">
            $forall hunk <- gdHunks diff
              <div class="diff-hunk mb-3">
                <div class="diff-header bg-light border p-2 small">
                  @@ -#{dhOldStart hunk},#{dhOldCount hunk} +#{dhNewStart hunk},#{dhNewCount hunk} @@

                <div class="diff-body">
                  $forall line <- dhLines hunk
                    <div class="diff-line #{lineClass $ dlType line}" data-line="#{lineNumber line}">
                      <div class="d-flex">
                        <div class="line-number user-select-none text-muted px-2 border-right">
                          #{lineNumber line}
                        <div class="line-content px-2 flex-grow-1">
                          <pre class="mb-0"><code>#{dlContent line}
                        <div class="line-actions px-2 invisible">
                          <button class="btn btn-sm btn-link p-0" data-toggle="modal" data-target="#commentModal" data-file="#{gdNewPath diff}" data-line="#{lineNumber line}">
                            <i class="fas fa-comment">

<!-- Comment Modal -->
<div class="modal fade" id="commentModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Add Comment
        <button type="button" class="close" data-dismiss="modal">
          <span>&times;
      <div class="modal-body">
        <form method="post" action="@{ChangeR $ keyToText changeId}/comment">
          <input type="hidden" name="file" id="commentFile">
          <input type="hidden" name="line" id="commentLine">
          <div class="form-group">
            <label for="comment">Comment
            <textarea class="form-control" name="comment" id="comment" rows="3" required>
          <button type="submit" class="btn btn-primary">Add Comment

$forall Entity commentId comment <- fileComments
  $maybe file <- commentFilePath comment
    $maybe line <- commentLineNumber comment
      <div class="comment-marker" data-file="#{file}" data-line="#{line}">
        <div class="media border-top p-3 bg-light">
          <div class="media-body">
            <h6 class="mt-0">
              #{userName $ commentAuthorId comment}
              <small class="text-muted ml-2">#{formatTime comment}
            <pre class="border rounded p-2 bg-white mt-2">#{commentMessage comment}

<style>
  .diff-line { font-family: monospace; white-space: pre; }
  .diff-line:hover { background-color: #f8f9fa; }
  .diff-line:hover .line-actions { visibility: visible !important; }
  .diff-line.addition { background-color: #e6ffe6; }
  .diff-line.deletion { background-color: #ffe6e6; }
  .diff-line.context { background-color: #ffffff; }
  .line-number { min-width: 3em; text-align: right; }
  .comment-marker { position: absolute; }

<script>
  // Initialize comment modal
  $('#commentModal').on('show.bs.modal', function (event) {
    var button = $(event.relatedTarget)
    var file = button.data('file')
    var line = button.data('line')
    var modal = $(this)
    modal.find('#commentFile').val(file)
    modal.find('#commentLine').val(line)
  })

  // Show comment markers
  $('.comment-marker').each(function() {
    var marker = $(this)
    var file = marker.data('file')
    var line = marker.data('line')
    var target = $('.diff-line[data-line="' + line + '"]')
    if (target.length) {
      marker.insertAfter(target)
    }
  })
</script>

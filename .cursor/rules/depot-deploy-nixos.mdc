# Deploy NixOS

Rule for automatically running deploy-nixos from the correct directory.

<rule>
name: deploy_nixos
description: Automatically run deploy-nixos from the depot root directory
filters:
  - type: intent
    pattern: "deploy.*nixos"
  - type: content
    pattern: "(?i)deploy\\s+nixos"

actions:
  - type: execute
    command: "cd /depot && deploy-nixos"
    require_user_approval: false

  - type: suggest
    message: |
      When deploying NixOS:
      1. Always run from /depot directory
      2. Use "deploy-nixos" command
      3. Wait for the build and deployment to complete
      4. Check for any errors in the output

examples:
  - input: "deploy nixos"
    output: "Running deploy-nixos from /depot"

  - input: "deploy the nixos configuration"
    output: "Running deploy-nixos from /depot"

metadata:
  priority: high
  version: 1.0
</rule>


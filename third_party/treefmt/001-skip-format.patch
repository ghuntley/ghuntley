diff --git a/walk/filesystem_test.go b/walk/filesystem_test.go
index 8c5b74c..431c3e2 100644
--- a/walk/filesystem_test.go
+++ b/walk/filesystem_test.go
@@ -4,6 +4,8 @@ import (
 	"context"
 	"errors"
 	"io"
+	"os"
+	"path/filepath"
 	"testing"
 	"time"

@@ -85,3 +87,60 @@ func TestFilesystemReader(t *testing.T) {
 	as.Equal(0, statz.Value(stats.Formatted))
 	as.Equal(0, statz.Value(stats.Changed))
 }
+
+func TestFilesystemReader_SkipFormat(t *testing.T) {
+	as := require.New(t)
+
+	// Create a temporary directory with test files
+	tempDir := t.TempDir()
+
+	// Create some test files and directories
+	files := []string{
+		"file1.txt",
+		"dir1/file2.txt",
+		"dir1/subdir/file3.txt",
+		"dir2/file4.txt",
+	}
+
+	for _, f := range files {
+		path := filepath.Join(tempDir, f)
+		err := os.MkdirAll(filepath.Dir(path), 0o755)
+		as.NoError(err)
+		err = os.WriteFile(path, []byte("test"), 0o644)
+		as.NoError(err)
+	}
+
+	// Create .skip-format file in dir1
+	err := os.WriteFile(filepath.Join(tempDir, "dir1", ".skip-format"), []byte{}, 0o644)
+	as.NoError(err)
+
+	statz := stats.New()
+	r := walk.NewFilesystemReader(tempDir, "", &statz, 1024)
+
+	// Read all files
+	var foundFiles []string
+	for {
+		ctx, cancel := context.WithTimeout(context.Background(), 100*time.Millisecond)
+		files := make([]*walk.File, 8)
+		n, err := r.Read(ctx, files)
+		cancel()
+
+		for i := 0; i < n; i++ {
+			foundFiles = append(foundFiles, files[i].RelPath)
+		}
+
+		if errors.Is(err, io.EOF) {
+			break
+		}
+		as.NoError(err)
+	}
+
+	// Should only find files not in dir1 or its subdirectories
+	expectedFiles := []string{
+		"file1.txt",
+		"dir2/file4.txt",
+	}
+
+	as.ElementsMatch(expectedFiles, foundFiles)
+	as.Equal(2, statz.Value(stats.Traversed))
+}
